# Application
APP_URL=http://localhost:3000
APP_ENV=development
SESSION_COOKIE_NAME=woob_session
SESSION_TTL_DAYS=14
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Administration plateforme : emails séparés par des virgules, ou `npm run admin:grant -- email@example.com`.
# Aucun administrateur n’est attribué automatiquement à l’inscription.
PLATFORM_ADMIN_EMAILS=

# Persistance : PostgreSQL recommandé en production.
# Sans DATABASE_URL, Woob utilise PGlite dans .woob-data (développement uniquement).
DATABASE_URL=
# PGSSL=require active TLS avec vérification ; disable uniquement pour un réseau maîtrisé.
PGSSL=
PGSSL_REJECT_UNAUTHORIZED=true
WOOB_DATA_DIR=.woob-data

# Médias : local par défaut. S3 est activé uniquement avec cette configuration complète.
STORAGE_DRIVER=file
STORAGE_LOCAL_DIR=.woob-storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_BYTES=5242880

# IA : demo déterministe par défaut, openai uniquement avec une clé serveur.
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Les quotas IA mensuels sont définis par le plan en base.

# Email transactionnel : fichier .woob-outbox en développement, SMTP en production.
EMAIL_DRIVER=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Woob <no-reply@localhost>

# Facturation : aucun paiement sans configuration Stripe complète.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Domaines : la vérification DNS réelle est optionnelle et désactivée par défaut en local.
DNS_VERIFICATION_ENABLED=false
WOOB_PUBLISH_BASE_DOMAIN=

# Sécurité et abus : true seulement derrière un proxy qui réécrit X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
